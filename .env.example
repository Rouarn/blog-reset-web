# ============================================================
# Blog Reset Version 环境变量示例
#
# 本项目把变量拆成三份文件，按下面的分节复制到对应文件即可：
#   「全模式共用」  → .env
#   「开发环境」    → .env.development
#   「生产环境」    → .env.production
# 每个键标注：用途 / 是否必填 / 默认值 / 示例 / 取值来源。示例值均为占位符，请按需替换。
# ⚠ 只有 VITE_ 前缀的键会被 Vite 内联进前端产物（import.meta.env.*），
#   在浏览器里可以直接读到，禁止写入密钥、令牌或私有接口凭证。
#   非 VITE_ 前缀的键（BROWSER）只在本机 CLI 进程里使用，不会打进浏览器。
# ============================================================

# ===== 全模式共用 → .env =====

# ---------- 应用信息 ----------

# VITE_APP_TITLE：浏览器标签页标题。【可选，建议填写】默认空（此时 index.html 会残留 %VITE_APP_TITLE% 占位符）
# 示例：'My Blog'（用单引号包裹，可含中文与空格）
# 取值：自行命名；构建时由 Vite 替换 index.html 中 <title> 的 %VITE_APP_TITLE%
VITE_APP_TITLE='My Blog'

# ---------- 本地开发服务器 ----------

# VITE_PORT：pnpm dev 的本地监听端口。【可选】默认 Vite 内置端口 5173
# 示例：5173
# 取值：本机空闲端口（1-65535）；只影响本机开发，与线上部署无关
VITE_PORT=5173

# VITE_OPEN：启动开发服务器后是否自动打开浏览器。【可选】默认 N（不打开）
# 示例：Y（自动打开）| N（不打开）
# 取值：代码只认 Y，其它任何值都等同于 N
VITE_OPEN=N

# BROWSER：自动打开浏览器时指定使用的浏览器。【可选】默认系统默认浏览器（留空或注释掉本行）
# 示例：google chrome（macOS 上 Vite 能识别的 Chrome 写法）| open（macOS 用系统默认浏览器）| none（完全不打开）
# 取值：由 Vite 的 openBrowser 读取；macOS 只对 google chrome / open 做特殊处理，直接写 chrome 通常打不开；仅本机 CLI 进程使用，不会打进浏览器
BROWSER="google chrome"

# ---------- 本地代理调试 ----------

# VITE_HTTP_PROXY：是否启用开发代理。【可选】默认 N（不启用）
# 示例：Y
# 取值：Y/N；VITE_PROXY 里的转发规则只有在 Y 时才会注册，且仅 pnpm dev 生效，build / preview 不生效
VITE_HTTP_PROXY=Y

# VITE_PROXY_LOG：是否打印代理转发日志。【可选】默认 N
# 示例：Y
# 取值：Y/N；开启后终端会打印 [proxy url] → [real request url]，排查接口 404/502 时使用，需 VITE_HTTP_PROXY=Y
VITE_PROXY_LOG=N

# ---------- 本地存储 ----------

# VITE_STORAGE_PREFIX：localStorage / sessionStorage 的键名前缀。【可选】默认空（不加前缀）
# 示例：MyBlog_（实际键名形如 MyBlog_token）
# 取值：自行指定；改动等于换了一套键名，已有用户的登录态与主题缓存会失效一次
VITE_STORAGE_PREFIX=

# ---------- 开发工具 ----------

# VITE_DEVTOOLS_LAUNCH_EDITOR：Vue DevTools 里「打开组件源码」所用的编辑器。【必填】无默认值，缺失时插件实际会收到字符串 "undefined"
# 示例：code（VS Code）| webstorm | idea | /Applications/YourEditor.app/Contents/MacOS/xxx
# 取值：本机已安装编辑器的命令或可执行文件路径；该插件只在开发模式可用，构建模式不生效
VITE_DEVTOOLS_LAUNCH_EDITOR=code

# ---------- 版本更新检测 ----------

# VITE_AUTOMATICALLY_DETECT_UPDATE：是否自动检测前端新版本。【可选】默认 N
# 示例：Y
# 取值：Y/N；仅在 VITE_USER_NODE_ENV=production 时生效，每 3 分钟拉一次 index.html 比对 buildTime，发现新版本弹刷新提示
VITE_AUTOMATICALLY_DETECT_UPDATE=Y

# ---------- 部署路径 ----------

# VITE_BASE_URL：应用部署的公共基础路径。【可选】默认 /（域名根目录）
# 示例：/（根目录）| /admin/（子目录必须以 / 开头和结尾，不能写成 /admin）
# 取值：与线上实际访问路径保持一致；同时用于拼接 index.html 的版本检测地址，配错会导致静态资源 404
VITE_BASE_URL=/

# ---------- 图标 ----------

# VITE_ICON_PREFIX：Iconify / UnoCSS 图标的类名前缀。【必填】默认 icon
# 示例：icon（对应 class="icon-mdi-home" 这样的写法）
# 取值：固定为 icon；改动需同步 src/typings/vite-env.d.ts 里的类型声明，否则本地图标集合名会解析错
VITE_ICON_PREFIX=icon

# VITE_ICON_LOCAL_PREFIX：本地 SVG 图标集合的引用前缀。【必填】必须形如 {VITE_ICON_PREFIX}-xxx
# 示例：icon-local（去掉 ${VITE_ICON_PREFIX}- 后的 local 即图标集合名）
# 取值：src/assets/svg-icon 下图标的前缀；必须包含 VITE_ICON_PREFIX，配错会导致本地图标全部无法解析
VITE_ICON_LOCAL_PREFIX=icon-local

# ---------- 认证 ----------

# VITE_ENABLE_TOKEN_REFRESH：是否启用双 token 自动续期。【可选】默认 N（单 token）
# 示例：Y（401 时用 refreshToken 换新 token 并重放原请求）| N（401 直接清登录态并跳登录页）
# 取值：Y/N，大小写不敏感；启用后后端需提供 POST /api/auth/refresh 接口并返回 accessToken/refreshToken
VITE_ENABLE_TOKEN_REFRESH=N

# ===== 开发环境 → .env.development =====

# ---------- 运行模式与构建 ----------

# VITE_USER_NODE_ENV：当前运行环境标识。【必填】无默认值
# 示例：development | production
# 取值：开发文件填 development；代码用它判断 isDevMode()、主题设置是否缓存、是否启用版本更新检测
VITE_USER_NODE_ENV=development

# VITE_ROUTER_MODE：路由历史模式。【必填】无默认值（缺失时创建路由会直接抛错）
# 示例：hash | history | memory
# 取值：hash 刷新无需服务端支持；history 需要服务端把所有未命中路径回落到 index.html；memory 一般只用于测试
VITE_ROUTER_MODE=hash

# VITE_DROP_CONSOLE：构建时是否删除 console.* 调用。【可选】默认 N（保留）
# 示例：Y | N
# 取值：代码只认 Y；仅在 build 阶段由 terser 生效（开发服务器仍会输出 console，但始终删除 debugger）
VITE_DROP_CONSOLE=N

# ---------- 接口地址 ----------

# VITE_SERVICE_BASE_URL：axios 请求的基础地址。【可选】默认空（走当前页面同源相对路径）
# 示例：/proxy-node（配合下方代理转发到真实后端）| http://127.0.0.1:8898（直连本地后端）
# 取值：开发环境一般填写 VITE_PROXY 中某个需要代理的前缀；请求会带上 Cookie（withCredentials: true），跨域直连需后端放行凭证
VITE_SERVICE_BASE_URL=/proxy-default

# VITE_PROXY：开发环境跨域代理规则。【可选】默认空数组（不转发任何请求）
# 示例："[["/proxy-default","http://127.0.0.1:8898"],["/proxy-node","https://api.example.com"]]"（JSON 字符串，必须能被 JSON.parse 解析）
# 取值：[[前缀, 目标地址], ...] 的二维数组；匹配到前缀的请求会去掉前缀后转发到目标，https 目标自动跳过证书校验；需 VITE_HTTP_PROXY=Y 且仅 pnpm dev 生效
VITE_PROXY="[["/proxy-default","http://127.0.0.1:8898"],["/proxy-node","https://api.example.com"]]"

# ===== 生产环境 → .env.production =====

# ---------- 运行模式与构建 ----------

# VITE_USER_NODE_ENV：当前运行环境标识。【必填】无默认值
# 示例：production | development
# 取值：生产文件填 production；production 时主题设置会写入 localStorage 缓存，并配合 VITE_AUTOMATICALLY_DETECT_UPDATE 才启用版本更新检测
VITE_USER_NODE_ENV=production

# VITE_ROUTER_MODE：路由历史模式。【必填】无默认值（缺失时创建路由会直接抛错）
# 示例：hash | history | memory
# 取值：hash 部署最简单，刷新不会 404；history 需要服务端把所有未命中路径回落到 index.html，否则刷新子路由会 404
VITE_ROUTER_MODE=hash

# VITE_DROP_CONSOLE：构建时是否删除 console.* 调用。【可选】默认 N（保留）
# 示例：Y | N
# 取值：代码只认 Y；由 terser 在 build 阶段执行，置 N 会把调试日志打进线上产物
VITE_DROP_CONSOLE=Y

# ---------- 接口地址 ----------

# VITE_SERVICE_BASE_URL：axios 请求的基础地址，构建时固定。【可选】默认空（与站点同源）
# 示例：https://api.example.com（协议+域名，不要带结尾斜杠）| /api（同域反代到后端时使用）
# 取值：线上后端地址，必须与站点协议一致（HTTPS 页面请求 HTTP 接口会被浏览器按混合内容拦截）；改动后必须重新构建才会生效
VITE_SERVICE_BASE_URL=https://api.example.com

# ===== 可选能力（三份文件均未启用） =====

# ---------- 第三方服务 ----------

# VITE_ICONIFY_URL：Iconify 图标 API 的私有/离线服务地址。【可选】默认未设置（走官方 iconify.design 公共 API）
# 示例：https://iconify.example.com（只写到服务根路径，不带具体图标路径）
# 取值：自建 Iconify API 时填写；代码在启动时调用 addAPIProvider('', { resources: [该地址] })，内网部署时才需要
# VITE_ICONIFY_URL=https://iconify.example.com
